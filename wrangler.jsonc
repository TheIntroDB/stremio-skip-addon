{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidb-stremio-skip",
  "main": "src/index.ts",
  // Kept current on purpose: the Deploy to Cloudflare flow reads this file first.
  "compatibility_date": "2026-11-24",
  "observability": {
    "enabled": true
  }
  // No vars here on purpose. The API host is fixed in src/constants.ts, and the
  // TheIntroDB API key is required and belongs in a secret, not in a git file:
  //
  //   npx wrangler secret put TIDB_API_KEY
  //
  // The Deploy to Cloudflare flow asks for it (it is declared in package.json and
  // in .dev.vars.example); for `npm run dev`, put it in .dev.vars.
}
