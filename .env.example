# Copy to `.env` and run with:  node --env-file=.env dist/server.js
# In Docker use `-e NAME=value`; on Railway use the service's Variables tab.

# Required. Get one at https://theintrodb.org/docs
# Without it the addon refuses to look anything up (403 missing_api_key).
TIDB_API_KEY=

# Port to listen on.
PORT=8787

# Cutting progressive (.mkv/.mp4) sources by remuxing them with ffmpeg.
#   on        cut in the background; the first playback may still show the intro
#   blocking  hold the play request until the cut is ready (bounded, see below)
#   off       never cut a file: only HLS playlists are spliced
CUTS=on

# Where cut files are cached, and how much disk they may use before the oldest
# one is evicted. Point this at a volume you keep.
CACHE_DIR=./cache
CACHE_MAX_GB=50

# `blocking` mode only: how long a play request waits for ffmpeg.
CUT_WAIT_SECONDS=120

# Concurrent ffmpeg processes.
CUT_CONCURRENCY=2

# When a title's stream list is fetched, start cutting this many of its sources in
# the background, so the first playback lands on a ready cut. 0 disables it (then a
# cut starts only when the source is actually played).
PRECUT_SOURCES=2

# Override if ffmpeg is not on PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Development only: allow fetching a source addon on a private/loopback address.
# ALLOW_PRIVATE_HOSTS=1
