# Copy to `.env`, then either `docker compose up -d` (this file is read directly)
# or `node --env-file=.env dist/server.js`. In compose, `docker compose up -d` reads it.
# Nothing in here is required: everything has a default, and the two things people do
# change -- the API key and whether files are cut -- are also on the configuration page.

# Optional. TheIntroDB API key for the whole deployment. Get one at
# https://theintrodb.org/docs. Leave it unset and paste a key on the configuration page
# instead: it then rides in that install's link (see README, "API key"). Whichever way,
# lookups need a key -- anonymous ones are limited per IP.
TIDB_API_KEY=

# Port to listen on.
PORT=8787

# How much of each skip window's edges to leave alone, in seconds. A cut can only land
# on a keyframe, and TheIntroDB's timings describe *a* release of a title rather than
# necessarily the one being watched, so the first and last seconds of an intro are where
# dialogue can go missing. The skip starts this many seconds after the reported start and
# ends this many seconds before the reported end; 0 cuts exactly what is reported.
# Per install: the configuration page offers the same control, stored in the install link.
SKIP_MARGIN_SECONDS=2

# Generated subtitles (the config page's option; this is the deployment's switch). The speech
# models run on this host -- nothing is sent anywhere -- and their weights download on first use.
# SUBTITLES=off means they are never loaded at all.
SUBTITLES=on
# The language to recognise and refine (Align only refines some; others keep raw timings).
SUBTITLES_LANGUAGE=en
# How long a generated track is kept. It is tiny -- under 100 KB for a 45-minute episode -- and
# the audio it was made from is deleted as it goes, so a day costs a few megabytes.
SUBTITLES_TTL_HOURS=24
# How much audio goes to the recogniser in one go, and therefore how long each subtitle segment
# is. 30 is one recogniser window, which is why it is both the default and the floor; the 900
# ceiling is only a typo guard. A longer chunk means fewer, later cues.
SUBTITLES_CHUNK_SECONDS=30

# Relay every stream through this service (on by default). The sources people actually use are
# debrid files, and a debrid link is bound to the address that asked for it, so the player has to
# fetch from here. Set PROXY=off only for a source the player can reach directly.
PROXY=on

# How much of an episode must be ready before playback starts on it, in seconds. The
# processing card is played until then. Starting on a couple of seconds is what made
# Stremio decide an episode had ended, mark it watched and jump to the next one.
PREROLL_SECONDS=10

# Whether a file with no playlist of its own (.mkv/.mp4) is cut at all is the *install's*
# choice, on the configuration page ("Cutting"), stored in the install link -- there is no
# deployment setting for it. See AGENTS.md, "Cutting a file".

# Where package segments are cached, and how much disk they may use before the oldest
# one is evicted. Point this at a volume you keep.
CACHE_DIR=./cache
CACHE_MAX_GB=50

# How long a play request waits for the first segment of a file being packaged. A couple
# of seconds is the normal answer; the bound only matters when a source is slow.
CUT_WAIT_SECONDS=120

# Concurrent ffmpeg processes.
CUT_CONCURRENCY=2

# When a title's stream list is fetched, start packaging this many of its sources in
# the background, so the first playback lands on a playlist that is already there. 0
# disables it (then packaging starts only when the source is actually played).
PRECUT_SOURCES=2

# Override if ffmpeg is not on PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Development only: allow fetching a source addon on a private/loopback address.
# ALLOW_PRIVATE_HOSTS=1
