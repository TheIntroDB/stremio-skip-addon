{
  "name": "stremio-skip-addon",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted Stremio addon that removes intro, recap, credits and preview segments from your streams using TheIntroDB timings: it splices HLS playlists and remuxes progressive files.",
  "license": "GPL-3.0-or-later",
  "author": "TheIntroDB",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheIntroDB/stremio-skip-addon.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "verify:package": "node --import tsx scripts/verify-package.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
